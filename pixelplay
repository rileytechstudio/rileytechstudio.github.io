<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>KID PIX Museum Studio</title>
    <style>
        /* Modern Museum Touch Table Styling */
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            touch-action: none;
            font-family: 'Comic Sans MS', 'Chalkboard SE', 'Arial Rounded MT Bold', sans-serif;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #222;
            display: flex;
            flex-direction: column;
        }

        /* Top Bar */
        #header {
            height: 75px;
            background: linear-gradient(90deg, #ff0055, #ff9900, #33cc33, #0099ff, #9933ff);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            box-shadow: 0 6px 12px rgba(0,0,0,0.4);
            z-index: 10;
        }

        .brand-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .title {
            color: white;
            font-size: 2.2rem;
            font-weight: 900;
            text-shadow: 3px 3px 0 #000;
            letter-spacing: 2px;
        }

        .header-btn {
            background: #fff;
            border: 4px solid #000;
            border-radius: 18px;
            padding: 6px 18px;
            font-size: 1.3rem;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 4px 4px 0 #000;
            transition: transform 0.1s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header-btn:active {
            transform: translate(3px, 3px);
            box-shadow: 1px 1px 0 #000;
        }

        /* Main Workspace Layout */
        #workspace {
            flex: 1;
            display: flex;
            position: relative;
            background: #444;
            overflow: hidden;
        }

        /* Tools Sidebar (Extra Large Buttons for Touch) */
        #toolbar {
            width: 140px;
            background: #333;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 15px 5px;
            gap: 12px;
            box-shadow: 4px 0 10px rgba(0,0,0,0.5);
            z-index: 5;
            overflow-y: auto;
        }

        .tool-btn {
            width: 110px;
            height: 90px;
            background: #f0f0f0;
            border: 5px solid #000;
            border-radius: 22px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 4px 4px 0 #000;
            transition: transform 0.05s, background-color 0.2s;
        }

        .tool-btn .svg-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 42px;
        }

        .tool-btn .label {
            font-size: 0.85rem;
            font-weight: bold;
            color: #000;
            margin-top: 2px;
        }

        .tool-btn.active {
            background: #ffeb3b;
            border-color: #d32f2f;
            transform: scale(1.05);
        }

        .tool-btn:active {
            transform: translate(3px, 3px);
            box-shadow: 1px 1px 0 #000;
        }

        .btn-dynamite {
            background: #ff5252 !important;
            color: white;
        }

        .btn-ohno {
            background: #ff9800 !important;
            color: white;
        }

        /* Canvas Wrapper */
        #canvas-container {
            flex: 1;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #555;
            padding: 10px;
        }

        canvas {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            cursor: crosshair;
        }

        /* Sub-panel for Stamps or Sizes */
        #sub-panel {
            width: 130px;
            background: #3a3a3a;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 15px 5px;
            gap: 12px;
            box-shadow: -4px 0 10px rgba(0,0,0,0.5);
            z-index: 5;
            overflow-y: auto;
        }

        .sub-btn {
            width: 100px;
            height: 75px;
            background: #fff;
            border: 4px solid #000;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            cursor: pointer;
            box-shadow: 3px 3px 0 #000;
        }

        .sub-btn.active {
            background: #aef;
            border-color: #0077ff;
        }

        .sub-btn:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0 #000;
        }

        /* Color Palette Bar at Bottom */
        #palette {
            height: 110px;
            background: #222;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            padding: 10px 20px;
            box-shadow: 0 -6px 12px rgba(0,0,0,0.4);
            z-index: 10;
            overflow-x: auto;
        }

        .color-swatch {
            width: 75px;
            height: 75px;
            border-radius: 50%;
            border: 5px solid #fff;
            box-shadow: 0 4px 8px rgba(0,0,0,0.5);
            cursor: pointer;
            flex-shrink: 0;
            transition: transform 0.15s;
        }

        .color-swatch.active {
            transform: scale(1.25);
            border-color: #ffeb3b;
            box-shadow: 0 0 15px #ffeb3b;
        }

        /* Screen Shake Animation for Dynamite */
        .shake {
            animation: shakeAnim 0.5s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes shakeAnim {
            10%, 90% { transform: translate3d(-4px, 0, 0); }
            20%, 80% { transform: translate3d(8px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-12px, 0, 0); }
            40%, 60% { transform: translate3d(12px, 0, 0); }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <div id="header">
        <div class="brand-container">
            <!-- Bespoke Paint Palette SVG Icon -->
            <svg viewBox="0 0 24 24" width="42" height="42" fill="none">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-1 0-.83.67-1.5 1.5-1.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9z" fill="#FFF" stroke="#000" stroke-width="2"/>
                <circle cx="6.5" cy="11.5" r="1.8" fill="#E63946"/>
                <circle cx="9.5" cy="7.5" r="1.8" fill="#FF9F1C"/>
                <circle cx="14.5" cy="7.5" r="1.8" fill="#FFD166"/>
                <circle cx="17.5" cy="11.5" r="1.8" fill="#06D6A0"/>
            </svg>
            <div class="title">KID PIX STUDIO</div>
        </div>
        <div style="display: flex; gap: 15px;">
            <button class="header-btn" onclick="cycleTemplate()">
                <!-- Frame SVG -->
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="3" fill="#FFF"/>
                    <circle cx="8.5" cy="8.5" r="1.5" fill="#000"/>
                    <polyline points="21 15 16 10 5 21"/>
                </svg>
                Line Art Page
            </button>
            <button class="header-btn" onclick="toggleAudio()" id="audio-btn">
                <span id="audio-icon" style="display: flex; align-items: center;"></span>
                <span id="audio-text">Sound: ON</span>
            </button>
        </div>
    </div>

    <!-- Main Workspace -->
    <div id="workspace">
        <!-- Main Tools Sidebar -->
        <div id="toolbar">
            <button class="tool-btn active" id="btn-brush" onclick="selectTool('brush')">
                <div class="svg-icon">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#000" stroke-width="2">
                        <path d="M18 2l4 4-10 10H8v-4L18 2z" fill="#FF9F1C"/>
                        <path d="M4 20c0-2 2-4 4-4s4 2 4 4-2 2-4 2-4-1-4-2z" fill="#E63946"/>
                        <path d="M8 16l4 4" stroke-width="2"/>
                    </svg>
                </div>
                <span class="label">Paint Brush</span>
            </button>

            <button class="tool-btn" id="btn-wacky" onclick="selectTool('wacky')">
                <div class="svg-icon">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#000" stroke-width="2">
                        <path d="M12 2l2.4 5.2 5.6.8-4 4.1 1 5.7-5-2.8-5 2.8 1-5.7-4-4.1 5.6-.8z" fill="#FFD166"/>
                        <circle cx="4" cy="4" r="2.5" fill="#06D6A0"/>
                        <circle cx="20" cy="19" r="3" fill="#9D4EDD"/>
                        <circle cx="19" cy="4" r="2" fill="#FF6B6B"/>
                    </svg>
                </div>
                <span class="label">Wacky Brush</span>
            </button>

            <button class="tool-btn" id="btn-bucket" onclick="selectTool('bucket')">
                <div class="svg-icon">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 11L13 5 4.5 13.5C3.7 14.3 3.7 15.7 4.5 16.5L7.5 19.5C8.3 20.3 9.7 20.3 10.5 19.5L19 11Z" fill="#118AB2"/>
                        <path d="M22 18C22 20 19 22 19 22C19 22 16 20 16 18C16 16.3 17.3 15 19 15C20.7 15 22 16.3 22 18Z" fill="#FF9F1C"/>
                        <path d="M9 3L15 9"/>
                    </svg>
                </div>
                <span class="label">Paint Bucket</span>
            </button>

            <button class="tool-btn" id="btn-stamp" onclick="selectTool('stamp')">
                <div class="svg-icon">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v6"/>
                        <rect x="7" y="8" width="10" height="5" rx="2" fill="#FF6B6B"/>
                        <path d="M5 13h14v4H5z" fill="#8D99AE"/>
                        <path d="M3 17h18v4H3z" fill="#000"/>
                    </svg>
                </div>
                <span class="label">Stamps</span>
            </button>

            <button class="tool-btn" id="btn-eraser" onclick="selectTool('eraser')">
                <div class="svg-icon">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 2L21 7L9 19L4 14L16 2Z" fill="#FF6B6B"/>
                        <path d="M13 5L18 10"/>
                        <path d="M9 19L4 14L2 16C1.5 16.5 1.5 17.5 2 18L5 21C5.5 21.5 6.5 21.5 7 21L9 19Z" fill="#8D99AE"/>
                        <path d="M12 22H22"/>
                    </svg>
                </div>
                <span class="label">Eraser</span>
            </button>
            
            <hr style="width: 80%; border: 2px solid #555; margin: 5px 0;">

            <!-- Kid Pix Action Buttons -->
            <button class="tool-btn btn-ohno" onclick="triggerUndo()">
                <div class="svg-icon">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" fill="#FF9800"/>
                        <circle cx="8" cy="9" r="2" fill="#000"/>
                        <circle cx="16" cy="9" r="2" fill="#000"/>
                        <ellipse cx="12" cy="16" rx="3" ry="4" fill="#000"/>
                        <path d="M3 12a9 9 0 0 1 15-6.7" stroke="#FFF" stroke-width="3" fill="none"/>
                    </svg>
                </div>
                <span class="label">OH NO!</span>
            </button>

            <button class="tool-btn btn-dynamite" onclick="triggerDynamite()">
                <div class="svg-icon">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="7" y="7" width="10" height="15" rx="2" fill="#FF5252"/>
                        <path d="M12 7V4C12 3 13 2 14 2H16"/>
                        <path d="M18 2L19 1M18 4L20 4M16 1L16 0" stroke="#FFD166" stroke-width="2"/>
                        <text x="12" y="17" font-size="7" font-weight="900" fill="#FFF" text-anchor="middle" stroke="none">TNT</text>
                    </svg>
                </div>
                <span class="label">DYNAMITE</span>
            </button>
        </div>

        <!-- Canvas -->
        <div id="canvas-container">
            <canvas id="paintCanvas"></canvas>
        </div>

        <!-- Dynamic Sub Panel (Stamps / Sizes) -->
        <div id="sub-panel"></div>
    </div>

    <!-- Color Palette -->
    <div id="palette"></div>

    <script>
        // --- Sound Toggle SVGs ---
        const soundOnSvg = `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="#000"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>`;
        const soundOffSvg = `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="#000"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>`;

        // --- Emoji Stamp Selection ---
        const stamps = ['⭐', '🦄', '🐸', '❤️', '🚀', '🍦', '🌸', '🦖', '🎨', '👑'];

        // --- Web Audio Synthesizer for Authentic Sound FX ---
        let audioEnabled = true;
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            if (!audioEnabled) return;
            if (audioCtx.state === 'suspended') audioCtx.resume();

            const now = audioCtx.currentTime;

            if (type === 'stamp') {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(300, now);
                osc.frequency.exponentialRampToValueAtTime(800, now + 0.15);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(now); osc.stop(now + 0.15);
            } 
            else if (type === 'fill') {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(150, now);
                osc.frequency.linearRampToValueAtTime(400, now + 0.1);
                osc.frequency.linearRampToValueAtTime(200, now + 0.25);
                gain.gain.setValueAtTime(0.4, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(now); osc.stop(now + 0.25);
            } 
            else if (type === 'ohno') {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(400, now);
                osc.frequency.setValueAtTime(300, now + 0.15);
                osc.frequency.setValueAtTime(200, now + 0.3);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(now); osc.stop(now + 0.5);
            } 
            else if (type === 'dynamite') {
                const bufferSize = audioCtx.sampleRate * 0.5;
                const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                const output = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) output[i] = Math.random() * 2 - 1;
                const whiteNoise = audioCtx.createBufferSource();
                whiteNoise.buffer = buffer;
                const filter = audioCtx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, now);
                filter.frequency.linearRampToValueAtTime(50, now + 0.5);
                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(0.6, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                whiteNoise.connect(filter); filter.connect(gain); gain.connect(audioCtx.destination);
                whiteNoise.start(now);
            }
        }

        function toggleAudio() {
            audioEnabled = !audioEnabled;
            updateAudioButton();
        }

        function updateAudioButton() {
            document.getElementById('audio-icon').innerHTML = audioEnabled ? soundOnSvg : soundOffSvg;
            document.getElementById('audio-text').innerText = audioEnabled ? "Sound: ON" : "Sound: OFF";
        }

        // --- Application State ---
        const canvas = document.getElementById('paintCanvas');
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        const subPanel = document.getElementById('sub-panel');
        
        let currentTool = 'brush';
        let currentColor = '#E63946';
        let currentSize = 25;
        let currentStampIndex = 0;
        let activeTouches = {};
        let undoHistory = [];
        const MAX_UNDO = 5;

        const colors = [
            '#E63946', '#FF9F1C', '#FFD166', '#06D6A0', 
            '#118AB2', '#073B4C', '#9D4EDD', '#FF6B6B', 
            '#8D99AE', '#7F4F24', '#000000', '#FFFFFF'
        ];

        const brushSizes = [12, 25, 45, 70];
        let currentTemplateIndex = 0;
        const templates = ['blank', 'dinosaur', 'rocket', 'flower'];

        // --- Initialization ---
        window.addEventListener('load', () => {
            updateAudioButton();
            resizeCanvas();
            setupPalette();
            updateSubPanel();
            saveState();
            
            document.body.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });
            document.body.addEventListener('touchmove', (e) => e.preventDefault(), { passive: false });
        });

        window.addEventListener('resize', resizeCanvas);

        function resizeCanvas() {
            const container = document.getElementById('canvas-container');
            const rect = container.getBoundingClientRect();
            
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = canvas.width;
            tempCanvas.height = canvas.height;
            const tempCtx = tempCanvas.getContext('2d');
            tempCtx.drawImage(canvas, 0, 0);

            canvas.width = rect.width - 20;
            canvas.height = rect.height - 20;

            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            ctx.drawImage(tempCanvas, 0, 0, canvas.width, canvas.height);
            if (templates[currentTemplateIndex] !== 'blank') {
                drawTemplateOutline(templates[currentTemplateIndex]);
            }
        }

        // --- Palette & Controls ---
        function setupPalette() {
            const paletteEl = document.getElementById('palette');
            paletteEl.innerHTML = '';
            colors.forEach((color) => {
                const swatch = document.createElement('div');
                swatch.className = `color-swatch ${color === currentColor ? 'active' : ''}`;
                swatch.style.backgroundColor = color;
                swatch.onclick = () => {
                    currentColor = color;
                    document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
                    swatch.classList.add('active');
                };
                paletteEl.appendChild(swatch);
            });
        }

        function selectTool(tool) {
            currentTool = tool;
            document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
            const btn = document.getElementById(`btn-${tool}`);
            if (btn) btn.classList.add('active');
            updateSubPanel();
        }

        function updateSubPanel() {
            subPanel.innerHTML = '';
            if (currentTool === 'stamp') {
                stamps.forEach((stamp, idx) => {
                    const btn = document.createElement('div');
                    btn.className = `sub-btn ${idx === currentStampIndex ? 'active' : ''}`;
                    btn.innerText = stamp;
                    btn.onclick = () => {
                        currentStampIndex = idx;
                        updateSubPanel();
                    };
                    subPanel.appendChild(btn);
                });
            } else {
                brushSizes.forEach(size => {
                    const btn = document.createElement('div');
                    btn.className = `sub-btn ${size === currentSize ? 'active' : ''}`;
                    btn.innerHTML = `<div style="width:${size/1.5}px; height:${size/1.5}px; background:#000; border-radius:50%;"></div>`;
                    btn.onclick = () => {
                        currentSize = size;
                        updateSubPanel();
                    };
                    subPanel.appendChild(btn);
                });
            }
        }

        // --- Undo / State History ---
        function saveState() {
            if (undoHistory.length >= MAX_UNDO) undoHistory.shift();
            undoHistory.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
        }

        function triggerUndo() {
            if (undoHistory.length > 1) {
                undoHistory.pop();
                const prevState = undoHistory[undoHistory.length - 1];
                ctx.putImageData(prevState, 0, 0);
                playSound('ohno');
            }
        }

        function triggerDynamite() {
            playSound('dynamite');
            const workspace = document.getElementById('workspace');
            workspace.classList.add('shake');
            
            setTimeout(() => {
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                if (templates[currentTemplateIndex] !== 'blank') {
                    drawTemplateOutline(templates[currentTemplateIndex]);
                }
                saveState();
                workspace.classList.remove('shake');
            }, 300);
        }

        // --- Multi-Touch Drawing Engine ---
        canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
        canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
        canvas.addEventListener('touchend', handleTouchEnd, { passive: false });
        canvas.addEventListener('touchcancel', handleTouchEnd, { passive: false });

        let isMouseDown = false;
        canvas.addEventListener('mousedown', (e) => {
            isMouseDown = true;
            handleTouchStart({ preventDefault: ()=>{}, changedTouches: [{ identifier: 'mouse', clientX: e.clientX, clientY: e.clientY }] });
        });
        canvas.addEventListener('mousemove', (e) => {
            if (!isMouseDown) return;
            handleTouchMove({ preventDefault: ()=>{}, changedTouches: [{ identifier: 'mouse', clientX: e.clientX, clientY: e.clientY }] });
        });
        canvas.addEventListener('mouseup', (e) => {
            isMouseDown = false;
            handleTouchEnd({ preventDefault: ()=>{}, changedTouches: [{ identifier: 'mouse' }] });
        });

        function getCanvasCoords(touch) {
            const rect = canvas.getBoundingClientRect();
            return {
                x: Math.round(touch.clientX - rect.left),
                y: Math.round(touch.clientY - rect.top)
            };
        }

        function handleTouchStart(e) {
            e.preventDefault();
            saveState();

            for (let touch of e.changedTouches) {
                const id = touch.identifier;
                const coords = getCanvasCoords(touch);
                activeTouches[id] = coords;

                if (currentTool === 'brush' || currentTool === 'eraser' || currentTool === 'wacky') {
                    drawSegment(coords.x, coords.y, coords.x, coords.y);
                } else if (currentTool === 'stamp') {
                    drawStamp(coords.x, coords.y);
                    playSound('stamp');
                } else if (currentTool === 'bucket') {
                    floodFill(coords.x, coords.y, currentColor);
                    playSound('fill');
                }
            }
        }

        function handleTouchMove(e) {
            e.preventDefault();
            for (let touch of e.changedTouches) {
                const id = touch.identifier;
                const coords = getCanvasCoords(touch);
                const prevCoords = activeTouches[id];

                if (prevCoords && (currentTool === 'brush' || currentTool === 'eraser' || currentTool === 'wacky')) {
                    drawSegment(prevCoords.x, prevCoords.y, coords.x, coords.y);
                    activeTouches[id] = coords;
                }
            }
        }

        function handleTouchEnd(e) {
            e.preventDefault();
            for (let touch of e.changedTouches) {
                delete activeTouches[touch.identifier];
            }
        }

        // --- Drawing Tools Implementations ---
        function drawSegment(x1, y1, x2, y2) {
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            if (currentTool === 'brush') {
                ctx.strokeStyle = currentColor;
                ctx.lineWidth = currentSize;
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
            } 
            else if (currentTool === 'eraser') {
                ctx.strokeStyle = '#FFFFFF';
                ctx.lineWidth = currentSize * 1.5;
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
            } 
            else if (currentTool === 'wacky') {
                const count = 5;
                for (let i = 0; i < count; i++) {
                    const rx = x2 + (Math.random() - 0.5) * currentSize * 1.5;
                    const ry = y2 + (Math.random() - 0.5) * currentSize * 1.5;
                    const rSize = Math.random() * (currentSize / 2) + 5;
                    ctx.fillStyle = colors[Math.floor(Math.random() * colors.length)];
                    ctx.beginPath();
                    ctx.arc(rx, ry, rSize, 0, Math.PI * 2);
                    ctx.fill();
                }
            }
        }

        // --- Draw Stamp with Randomized Orientation ---
        function drawStamp(x, y) {
            const stamp = stamps[currentStampIndex];
            const randomAngle = Math.random() * Math.PI * 2; // Random rotation 0 - 360 deg

            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(randomAngle);
            ctx.font = `${currentSize * 2.5}px 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji', sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(stamp, 0, 0);
            ctx.restore();
        }

        // --- Fast Scanline Flood Fill Algorithm ---
        function floodFill(startX, startY, fillHex) {
            const width = canvas.width;
            const height = canvas.height;
            const imgData = ctx.getImageData(0, 0, width, height);
            const data = imgData.data;

            const targetRgb = hexToRgb(fillHex);
            const startIdx = (startY * width + startX) * 4;
            const startR = data[startIdx], startG = data[startIdx+1], startB = data[startIdx+2], startA = data[startIdx+3];

            if (colorMatch(startR, startG, startB, startA, targetRgb.r, targetRgb.g, targetRgb.b, 255)) return;

            const pixelStack = [[startX, startY]];

            while (pixelStack.length) {
                const newPos = pixelStack.pop();
                const x = newPos[0];
                let y = newPos[1];

                let pixelPos = (y * width + x) * 4;
                while (y >= 0 && colorMatch(data[pixelPos], data[pixelPos+1], data[pixelPos+2], data[pixelPos+3], startR, startG, startB, startA)) {
                    y--;
                    pixelPos -= width * 4;
                }
                pixelPos += width * 4;
                y++;

                let reachLeft = false;
                let reachRight = false;

                while (y < height && colorMatch(data[pixelPos], data[pixelPos+1], data[pixelPos+2], data[pixelPos+3], startR, startG, startB, startA)) {
                    data[pixelPos] = targetRgb.r;
                    data[pixelPos + 1] = targetRgb.g;
                    data[pixelPos + 2] = targetRgb.b;
                    data[pixelPos + 3] = 255;

                    if (x > 0) {
                        if (colorMatch(data[pixelPos - 4], data[pixelPos - 3], data[pixelPos - 2], data[pixelPos - 1], startR, startG, startB, startA)) {
                            if (!reachLeft) {
                                pixelStack.push([x - 1, y]);
                                reachLeft = true;
                            }
                        } else if (reachLeft) {
                            reachLeft = false;
                        }
                    }

                    if (x < width - 1) {
                        if (colorMatch(data[pixelPos + 4], data[pixelPos + 5], data[pixelPos + 6], data[pixelPos + 7], startR, startG, startB, startA)) {
                            if (!reachRight) {
                                pixelStack.push([x + 1, y]);
                                reachRight = true;
                            }
                        } else if (reachRight) {
                            reachRight = false;
                        }
                    }

                    y++;
                    pixelPos += width * 4;
                }
            }
            ctx.putImageData(imgData, 0, 0);
        }

        function colorMatch(r1, g1, b1, a1, r2, g2, b2, a2) {
            return Math.abs(r1 - r2) < 30 && Math.abs(g1 - g2) < 30 && Math.abs(b1 - b2) < 30 && Math.abs(a1 - a2) < 30;
        }

        function hexToRgb(hex) {
            const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
            return result ? {
                r: parseInt(result[1], 16),
                g: parseInt(result[2], 16),
                b: parseInt(result[3], 16)
            } : { r: 0, g: 0, b: 0 };
        }

        // --- Line Art Templates ---
        function cycleTemplate() {
            currentTemplateIndex = (currentTemplateIndex + 1) % templates.length;
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            if (templates[currentTemplateIndex] !== 'blank') {
                drawTemplateOutline(templates[currentTemplateIndex]);
            }
            saveState();
        }

        function drawTemplateOutline(template) {
            ctx.strokeStyle = '#000000';
            ctx.lineWidth = 8;
            ctx.lineCap = 'round';
            const cx = canvas.width / 2;
            const cy = canvas.height / 2;

            if (template === 'dinosaur') {
                ctx.beginPath();
                ctx.arc(cx - 50, cy - 100, 60, Math.PI * 0.8, Math.PI * 2.2);
                ctx.lineTo(cx + 80, cy + 50);
                ctx.quadraticCurveTo(cx + 180, cy + 100, cx + 220, cy + 30);
                ctx.quadraticCurveTo(cx + 160, cy + 140, cx + 80, cy + 130);
                ctx.lineTo(cx + 70, cy + 180); ctx.lineTo(cx + 40, cy + 180); ctx.lineTo(cx + 30, cy + 120);
                ctx.lineTo(cx - 30, cy + 120); ctx.lineTo(cx - 40, cy + 180); ctx.lineTo(cx - 70, cy + 180);
                ctx.lineTo(cx - 60, cy + 50);
                ctx.quadraticCurveTo(cx - 120, cy - 20, cx - 50, cy - 100);
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(cx - 70, cy - 110, 8, 0, Math.PI * 2);
                ctx.fillStyle = '#000'; ctx.fill();
            } 
            else if (template === 'rocket') {
                ctx.beginPath();
                ctx.moveTo(cx, cy - 180);
                ctx.quadraticCurveTo(cx + 90, cy - 50, cx + 60, cy + 100);
                ctx.lineTo(cx - 60, cy + 100);
                ctx.quadraticCurveTo(cx - 90, cy - 50, cx, cy - 180);
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(cx, cy - 20, 35, 0, Math.PI * 2);
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(cx - 60, cy + 30); ctx.lineTo(cx - 120, cy + 120); ctx.lineTo(cx - 60, cy + 100);
                ctx.moveTo(cx + 60, cy + 30); ctx.lineTo(cx + 120, cy + 120); ctx.lineTo(cx + 60, cy + 100);
                ctx.stroke();
            } 
            else if (template === 'flower') {
                ctx.beginPath();
                ctx.arc(cx, cy - 30, 50, 0, Math.PI * 2);
                ctx.stroke();

                for (let i = 0; i < 8; i++) {
                    const angle = (i * Math.PI) / 4;
                    const px = cx + Math.cos(angle) * 110;
                    const py = (cy - 30) + Math.sin(angle) * 110;
                    ctx.beginPath();
                    ctx.arc(px, py, 45, 0, Math.PI * 2);
                    ctx.stroke();
                }

                ctx.beginPath();
                ctx.moveTo(cx, cy + 20); ctx.lineTo(cx, cy + 200);
                ctx.lineWidth = 12;
                ctx.stroke();
            }
        }
    </script>
